# Database non-sensitive connection parameters
DB_USER=user
DB_HOST=localhost
DB_PORT=5432
DB_NAME=film_review

# Non-sensitive JWT settings
TOKEN_ACCESS_TOKEN_EXPIRE_MINUTES=30
TOKEN_REFRESH_TOKEN_EXPIRE_DAYS=7

# Non-sensitive API settings
CORS_ORIGINS=["http://localhost:3000"]
API_VERSION=v1
REDIS_URL=redis://localhost:6379/0
FILM_LIST_CACHE_TTL_SECONDS=300

# AWS Secrets Manager / Floci Local Simulator settings
AWS_SECRET_ID=film-review/platform
AWS_SECRETS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
